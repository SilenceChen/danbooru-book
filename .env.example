# Gemini API Key（必填）
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Danbooru 账号（选填，有账号可解锁更高频率 + 敏感内容图片）
DANBOORU_USERNAME=
DANBOORU_API_KEY=

# 数据库路径（默认在 backend/ 目录下）
DATABASE_URL=sqlite+aiosqlite:///./danbooru.db

# 定时爬取间隔（小时）
CRAWL_INTERVAL_HOURS=24

# 翻译每批数量（Gemini 单次调用处理的 tag 数）
TRANSLATE_BATCH_SIZE=50
